# Copia questo file in .env e compila i valori. Non versionare mai .env.

# Token del bot, ottenuto scrivendo a @BotFather su Telegram.
TELOXIDE_TOKEN=

# Chat_id autorizzati a usare il bot, separati da virgola.
# Per scoprire il proprio chat_id: scrivi al bot @userinfobot su Telegram.
ALLOWED_CHAT_IDS=

# Percorso del file del database SQLite.
DATABASE_URL=./data/db/gestionale.db
