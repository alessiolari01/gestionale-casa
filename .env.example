# Copia questo file in .env solo se non usi già variabili d'ambiente.
# Non versionare mai .env.

# Token del bot, ottenuto scrivendo a @BotFather su Telegram.
TELOXIDE_TOKEN=

# Chat_id autorizzati a usare il bot, separati da virgola.
# Esempio: 123456789,987654321
ALLOWED_CHAT_IDS=

# Percorso del file del database SQLite.
# Non viene ancora letto nello Step 3; entrerà in uso nello Step 4.
DATABASE_URL=./data/db/gestionale.db
