# Copia questo file in .env solo se non usi gia' variabili d'ambiente.
# Non versionare mai .env.

# Token del bot, ottenuto scrivendo a @BotFather su Telegram.
TELOXIDE_TOKEN=

# Chat_id autorizzati a usare il bot, separati da virgola.
# Esempio: 123456789,987654321
ALLOWED_CHAT_IDS=

# URL SQLite. Se DATABASE_URL non e' impostata, il backend usa automaticamente
# questo stesso valore come default.
DATABASE_URL=sqlite://data/db/gestionale.db
